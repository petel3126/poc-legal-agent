# ==============================================================================
# VNTech Legal AI — Biến Môi Trường Cấu Hình
# ==============================================================================

# 1. Google Gemini API Key (Bắt buộc để LLM suy luận và đọc ảnh hợp đồng)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase CSDL Nhân sự VNTech
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# 3. Cơ sở Dữ liệu Đồ thị Neo4j (Tự động kết nối khi chạy Docker Compose)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=legalpassword123
